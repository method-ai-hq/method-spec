{
  "name": "@withmethod/runtime",
  "version": "0.3.1",
  "description": "Open-source Method validator and local executor",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "method3": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*.js": {
      "types": "./types/src/*.d.ts",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "spec",
    "examples",
    "proposals",
    "vendor",
    "*.md",
    "LICENSE",
    "types",
    "test",
    "scripts"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "schema": "node scripts/emit-schema.js",
    "check": "npm run schema -- --check && npm test",
    "example": "node src/cli.js run examples/counter.method --config examples/local.config.json",
    "types": "tsc --allowJs --declaration --emitDeclarationOnly --outDir types --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck src/*.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/method-ai-hq/method-spec.git"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.10"
  }
}
