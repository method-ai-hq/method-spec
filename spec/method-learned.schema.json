{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/method-ai-hq/method-spec/raw/main/spec/method-learned.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "method-learned/1"
    },
    "steps": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^lr_[0-9a-f]{12}$"
            },
            "when": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "then": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "type": "object",
              "properties": {
                "judgment": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "case": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "status": {
              "enum": [
                "active",
                "retired"
              ]
            },
            "created": {
              "type": "string",
              "minLength": 1
            },
            "retired_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "retired_reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "meta": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "when",
            "then",
            "status"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "format",
    "steps"
  ],
  "additionalProperties": false
}
