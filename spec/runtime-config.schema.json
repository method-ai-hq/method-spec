{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "timeout_ms",
        "max_model_requests",
        "max_invocations",
        "max_tool_calls",
        "max_output_bytes",
        "max_request_bytes"
      ],
      "additionalProperties": false
    },
    "allow_local_processes": {
      "type": "boolean"
    },
    "runtimes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 80,
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "command",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 80,
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "backend": {
            "const": "openai-responses"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "api_key_env": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "reasoning_effort": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          }
        },
        "required": [
          "backend",
          "model",
          "api_key_env",
          "max_output_tokens"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 80,
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "in": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80,
              "not": {
                "enum": [
                  "constructor",
                  "prototype",
                  "__proto__"
                ]
              }
            },
            "additionalProperties": {
              "$ref": "https://github.com/method-ai-hq/method-spec/raw/main/spec/method-3.schema.json#/$defs/data"
            }
          },
          "out": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80,
              "not": {
                "enum": [
                  "constructor",
                  "prototype",
                  "__proto__"
                ]
              }
            },
            "additionalProperties": {
              "$ref": "https://github.com/method-ai-hq/method-spec/raw/main/spec/method-3.schema.json#/$defs/data"
            }
          },
          "run": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "run"
              },
              "runtime": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 80,
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "entrypoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "runtime",
              "entrypoint"
            ],
            "additionalProperties": false
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80,
              "not": {
                "enum": [
                  "constructor",
                  "prototype",
                  "__proto__"
                ]
              }
            },
            "uniqueItems": true
          }
        },
        "required": [
          "description",
          "in",
          "out",
          "run",
          "effects"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 80,
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "limits"
  ],
  "additionalProperties": false
}
